  "facts": [
    {
      "id": "fact-001",
      "category": "lore",
      "statement": "The campaign is set in the Kingdom of Aethelgard, an urban political intrigue setting with dark tone.",
      "source": "adventure_bible_v1",
      "immutable": true
    },
    {
      "id": "fact-002",
      "category": "lore",
      "statement": "Vlad 'The Raven' Dragomir was a tyrant who wielded La Hoja, a blade that cuts bonds rather than flesh.",
      "source": "lore.md",
      "immutable": true
    },
    {
      "id": "fact-003",
      "category": "lore",
      "statement": "Vlad disappeared after the Battle of Bloody River in year 859; his body was never found.",
      "source": "lore.md",
      "immutable": true
    },
    {
      "id": "fact-004",
      "category": "lore",
      "statement": "The Hoja must cut seven bonds to complete the ritual: Oath, Blood, Love, Loyalty, Hope, Faith, Life, and secretly Memory.",
      "source": "lore.md",
      "immutable": false
    },
    {
      "id": "fact-005",
      "category": "lore",
      "statement": "King Aldric IV rules from Corona del Alba but shows signs of madness; he has no legitimate heirs.",
      "source": "lore.md",
      "immutable": false
    },
    {
      "id": "fact-006",
      "category": "lore",
      "statement": "Five noble houses dominate: Valmont (trade), Blackthorne (military), Ravenshade (religion), Ironwood (mines), Whisperwind (spies).",
      "source": "lore.md",
      "immutable": true
    },
    {
      "id": "fact-007",
      "category": "lore",
      "statement": "The Cult of the Whisperer believes the Hoja is a key that will allow their entity to walk in the material world.",
      "source": "lore.md",
      "immutable": true
    }
  ],
